# InterviewIQ Full-Stack Environment Variables
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=https://interviewiq-peach-eight.vercel.app

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/interviewiq?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=interviewiq_super_secure_jwt_secret_key_2026_xyz
JWT_EXPIRE=30d

# Google Gemini AI API Key
GEMINI_API_KEY=your_google_gemini_api_key_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
